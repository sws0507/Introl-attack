+static bool cvm_trap_redirect_deferred(struct kvm_vcpu *vcpu,
+				       struct kvm_cpu_trap *trap)
+{
+	if (!vcpu->kvm->cmode)
+		return false;
+
+	return trap->scause == EXC_INST_ILLEGAL ||
+	       trap->scause == EXC_VIRTUAL_INST_FAULT;
+}
+
+static void cvm_record_trap_redirect(struct kvm_vcpu *vcpu,
+				     struct kvm_cpu_trap *trap)
+{
+	vcpu->arch.cvm_inject_trap = *trap;
+	vcpu->arch.cvm_inject_pending = true;
+
+	printk(KERN_INFO "Defer trap injection to OpenSBI: sepc=0x%lx, scause=0x%lx, stval=0x%lx\n",
+	       trap->sepc, trap->scause, trap->stval);
+}
