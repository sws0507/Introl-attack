+static int inject_cvm_vs_trap(struct cvm_vcpu *cvm_vcpu, struct iie_cvm_sbi_params *cvm_sbi_params)
+{
+    unsigned long vsstatus;
+
+    if (!cvm_sbi_params->inject_scause)
+        return 0;
+
+    if (cvm_sbi_params->inject_scause != CAUSE_ILLEGAL_INSTRUCTION &&
+        cvm_sbi_params->inject_scause != CAUSE_VIRTUAL_INST_FAULT) {
+        sbi_printf("[IIE CVM Monitor@%s] unsupported inject scause=0x%lx\n",
+                   __func__, cvm_sbi_params->inject_scause);
+        return 0;
+    }
+
+    if (!cvm_vcpu->guest_csr_initialized)
+        save_guest_vs_csrs(cvm_vcpu);
+
+    if (!cvm_vs_is_kernel_addr(cvm_vcpu, cvm_vcpu->guest_csr.vsscratch)) {
+        sbi_printf("[IIE CVM Monitor@%s] refuse inject scause=0x%lx because guest VSSCRATCH=0x%lx is not a kernel address, vsatp=0x%lx\n",
+                   __func__, cvm_sbi_params->inject_scause,
+                   cvm_vcpu->guest_csr.vsscratch,
+                   cvm_vcpu->guest_csr.vsatp);
+        return CVM_ERROR;
+    }
+
+    vsstatus = cvm_vcpu->guest_csr.vsstatus;
+
+    vsstatus &= ~SSTATUS_SPP;
+    if (cvm_vcpu->guest_context.sstatus & SSTATUS_SPP)
+        vsstatus |= SSTATUS_SPP;
+
+    vsstatus &= ~SSTATUS_SPIE;
+    if (vsstatus & SSTATUS_SIE)
+        vsstatus |= SSTATUS_SPIE;
+
+    vsstatus &= ~SSTATUS_SIE;
+
+    cvm_vcpu->guest_csr.vsstatus = vsstatus;
+    cvm_vcpu->guest_csr.vscause = cvm_sbi_params->inject_scause;
+    cvm_vcpu->guest_csr.vstval = cvm_sbi_params->inject_stval;
+    cvm_vcpu->guest_csr.vsepc = cvm_sbi_params->inject_sepc;
+    cvm_vcpu->guest_context.sepc = cvm_vcpu->guest_csr.vstvec;
+    cvm_vcpu->guest_context.sstatus |= SSTATUS_SPP;
+    cvm_vcpu->guest_context.hstatus |= HSTATUS_SPV;
+    cvm_vcpu->guest_mstatus &= ~MSTATUS_MPP;
+    cvm_vcpu->guest_mstatus |= PRV_S << MSTATUS_MPP_SHIFT;
+    cvm_vcpu->guest_mstatus |= MSTATUS_MPV;
+    cvm_vcpu->guest_csr_initialized = 1;
+
+    sbi_printf("[IIE CVM Monitor@%s] inject VS trap: scause=0x%lx stval=0x%lx vsepc=0x%lx vstvec=0x%lx\n",
+               __func__, cvm_vcpu->guest_csr.vscause, cvm_vcpu->guest_csr.vstval,
+               cvm_vcpu->guest_csr.vsepc, cvm_vcpu->guest_csr.vstvec);
+    return 0;
+}
