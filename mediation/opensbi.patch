+static unsigned long cvm_vs_kernel_addr_start(unsigned long vsatp)
+{
+#if __riscv_xlen == 64
+    unsigned long va_bits = 39;
+    unsigned long mode = (vsatp & SATP64_MODE) >> CVM_SATP64_MODE_SHIFT;
+
+    if (mode == SATP_MODE_SV57)
+        va_bits = 57;
+    else if (mode == SATP_MODE_SV48)
+        va_bits = 48;
+
+    return ~((1UL << (va_bits - 1)) - 1);
+#else
+    return 1UL << (__riscv_xlen - 1);
+#endif
+}
+
+static bool cvm_vs_is_kernel_addr(struct cvm_vcpu *cvm_vcpu, unsigned long addr)
+{
+    return addr >= cvm_vs_kernel_addr_start(cvm_vcpu->guest_csr.vsatp);
+}
